<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <application android:label="Bloqueador" android:icon="@android:drawable/ic_lock_silent_mode" android:theme="@style/Theme.App">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".Triagem" android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter><action android:name="android.telecom.CallScreeningService" /></intent-filter>
        </service>
    </application>
</manifest>
